{% block body %}
    {% set active = '' %}
    {% if app.request.uri|lower is not empty and 'vyroba-nabytku' in app.request.uri|lower %}
        {% set active = 'active' %}
    {% endif %}
    <div>
        <div class="d-flex top-navbar d-none d-lg-flex">
        <span class="me-3">
            <a href="mailto:dvorscik.anton@gmail.com"><i class="fas fa-envelope me-2"></i>dvorscik.anton@gmail.com</a>
        </span>
            <span class="me-3">
            <a href="tel:+421908743805"><i class="fas fa-phone me-2"></i>0908 743 805</a>
        </span>
        </div>
        <nav class="navbar navbar-expand-lg navbar-dark text-center fixed-top">
            <div class="container">
                <a class="navbar-brand" href="/"><img src="/build/images/logoT2.png" alt="logo" class="logo-navbar"></a>
                <button class="navbar-toggler collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarNavAltMarkup"
                        aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar top-bar"></span>
                    <span class="icon-bar middle-bar"></span>
                    <span class="icon-bar bottom-bar"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a
                                class="nav-link {{ app.request.attributes.get('_route') == 'app_home_page' ? 'active' : '' }}"
                                href="/"
                            >
                                O nás
                            </a>
                        </li>
                        <li class="nav-item">
                            <a
                                class="nav-link {{ app.request.attributes.get('_route') == 'app_services' ? 'active' : '' }}"
                                href="/nase-sluzby"
                            >
                                Naše služby
                            </a>
                        </li>
                        <li class="nav-item mobile-submenu-item d-lg-none d-block">
                            <a class="nav-link mobile-submenu-toggle {{ active }}" href="#"
                               data-bs-toggle="collapse" data-bs-target="#mobileFurnitureMenu"
                               role="button" aria-expanded="false" aria-controls="mobileFurnitureMenu">
                                Výroba nábytku
                                <i class="fas fa-chevron-down mobile-submenu-toggle__chevron"></i>
                            </a>
                            <div class="collapse" id="mobileFurnitureMenu">
                                <ul class="mobile-submenu list-unstyled">
                                    <li>
                                        <a class="mobile-submenu__item" href="/vyroba-nabytku/kuchyne-na-mieru">
                                            <img src="/build/images/kitchen.png" alt="" class="mobile-submenu__icon">
                                            Kuchyne na mieru
                                        </a>
                                    </li>
                                    <li>
                                        <a class="mobile-submenu__item" href="/vyroba-nabytku/vstavane-skrine">
                                            <img src="/build/images/wardrobe.png" alt="" class="mobile-submenu__icon">
                                            Vstavané skrine
                                        </a>
                                    </li>
                                    <li>
                                        <a class="mobile-submenu__item" href="/vyroba-nabytku/kupelnovy-nabytok">
                                            <img src="/build/images/bathroom.png" alt="" class="mobile-submenu__icon">
                                            Kúpeľňový nábytok
                                        </a>
                                    </li>
                                    <li>
                                        <a class="mobile-submenu__item" href="/vyroba-nabytku/atypicky-nabytok">
                                            <img src="/build/images/tape-measure.png" alt="" class="mobile-submenu__icon">
                                            A-typický nábytok
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="nav-item dropdown d-none d-lg-block">
                            <a class="nav-link dropdown-toggle {{ active }}" href="#" id="navbarDropdownDesktop" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Výroba nábytku
                            </a>
                            <ul class="dropdown-menu" id="pc" aria-labelledby="navbarDropdownDesktop">
                                <li>
                                    <a class="dropdown-item" href="/vyroba-nabytku/kuchyne-na-mieru">
                                        <img src="/build/images/kitchen.png" alt="Kuchyne na mieru" class="icon-img">&nbsp;
                                        Kuchyne na mieru
                                    </a>
                                </li>
                                <li><a class="dropdown-item" href="/vyroba-nabytku/vstavane-skrine">
                                        <img src="/build/images/wardrobe.png" alt="Vstavané skrine" class="icon-img">&nbsp;
                                        Vstavané skrine</a></li>
                                <li><a class="dropdown-item" href="/vyroba-nabytku/kupelnovy-nabytok">
                                        <img src="/build/images/bathroom.png" alt="Kúpeľňový nábytok" class="icon-img">&nbsp;
                                        Kúpelňový nábytok</a></li>
                                <li><a class="dropdown-item" href="/vyroba-nabytku/atypicky-nabytok">
                                        <img src="/build/images/tape-measure.png" alt="A-typický nábytok" class="icon-img">&nbsp;
                                        A-typický nábytok</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a
                                class="nav-link {{ app.request.attributes.get('_route') == 'app_reviews' ? 'active' : '' }}"
                                href="/recenzie"
                            >
                                Recenzie
                            </a>
                        </li>
                        <li class="nav-item">
                            <a
                                class="nav-link {{ app.request.attributes.get('_route') == 'app_materials' ? 'active' : '' }}"
                                href="/materialy"
                            >
                                Materiály
                            </a>
                        </li>
                        <li class="nav-item">
                            <a
                                class="nav-link {{ app.request.attributes.get('_route') == 'app_fittings' ? 'active' : '' }}"
                                href="/kovania"
                            >
                                Kovania
                            </a>
                        </li>
                        <li class="nav-item">
                            <a
                                class="nav-link {{ app.request.attributes.get('_route') == 'app_contact' ? 'active' : '' }}"
                                href="/kontakt"
                            >
                                Kontakt
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </div>
{% endblock %}
