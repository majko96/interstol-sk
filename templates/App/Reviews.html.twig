{% extends 'base.html.twig' %}
{% block title %}Recenzie zákazníkov | Interstol.sk{% endblock %}
{% block meta_description %}Prečítajte si, čo o spolupráci so stolárstvom Interstol hovoria naši spokojní zákazníci.{% endblock %}
{% block og_title %}{{ block('title') }}{% endblock %}
{% block og_description %}{{ block('meta_description') }}{% endblock %}
{% block body %}
    {% block stylesheets %}
        {{ parent() }}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    {% endblock %}
    <div class="container mt100 mb-5">
        <div class="reviews-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <h1 class="mb-0">
                    Recenzie
                </h1>
{#            <a#}
{#                    href="https://search.google.com/local/writereview?placeid={{ googlePlaceId }}"#}
{#                    target="_blank"#}
{#                    class="btn btn-secondary send-button d-flex align-items-center"#}
{#            >#}
{#                <i class="fas fa-plus me-3"></i>#}
{#                Pridať recenziu#}
{#            </a>#}
                <div data-react-container="References"></div>
            </div>
        </div>

        {% if reviews is empty %}
            <div class="alert alert-info">Zatiaľ nemáme žiadne recenzie.</div>
        {% else %}
            <div class="reviews-list mt-5">
                {% for review in reviews %}
                    {% set nameParts = review.name|split(' ') %}
                    {% set initials = nameParts[0]|slice(0, 1) %}
                    {% if nameParts|length > 1 %}
                        {% set initials = initials ~ nameParts[nameParts|length - 1]|slice(0, 1) %}
                    {% endif %}
                    <div class="review-item">
                        <div class="review-item__avatar">{{ initials|upper }}</div>
                        <div class="review-item__body">
                            <div class="review-item__top">
                                <h5 class="review-item__name">{{ review.name }}</h5>
                                <div class="review-item__stars">
                                    {% for i in 1..5 %}
                                        {% if i <= review.value %}
                                            <i class="bi bi-star-fill"></i>
                                        {% else %}
                                            <i class="bi bi-star"></i>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <div class="review-item__date">{{ review.createdAt|date('d.m.Y') }}</div>
                            </div>
                            <p class="review-item__text">{{ review.text }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}

