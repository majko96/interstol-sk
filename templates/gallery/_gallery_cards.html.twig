<div class="row g-4 project-cards">
    {% for item in galleries %}
        {% set count = item.images|length %}
        <div class="col-sm-6 col-lg-4">
            <a href="{{ item.images[0].full }}" data-fancybox="kitchen-projects" data-caption="{{ item.title }}" class="project-card">
                <div class="project-card__media">
                    <img
                            src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
                            data-src="{{ item.images[0].thumb }}"
                            loading="lazy"
                            class="lazy-image"
                            alt="{{ item.title }}"
                    >
                    <div class="project-card__scrim"></div>
                    {% if count > 1 %}
                        <span class="project-card__count">{{ count }} {{ count == 1 ? 'fotka' : (count < 5 ? 'fotky' : 'fotiek') }}</span>
                    {% endif %}
                    <h2 class="project-card__title">{{ item.title }}</h2>
                </div>
            </a>

            {% for image in item.images %}
                {% if not loop.first %}
                    <a href="{{ image.full }}" data-fancybox="kitchen-projects" data-caption="{{ item.title }}" class="d-none" tabindex="-1">
                        <img src="{{ image.thumb }}" alt="Foto" loading="lazy">
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    {% endfor %}
</div>
