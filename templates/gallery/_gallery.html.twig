<div class="row g-3 gallery-container" data-gallery-index="{{ galleryIndex }}">
    {% for image in gallery %}
        <div class="col-6 col-md-3 col-lg-3" data-index="{{ loop.index }}">
            <a href="{{ image.full }}" data-fancybox="gallery-{{ galleryIndex }}" class="d-block ratio ratio-1x1 photo-thumb" target="_blank">
                <img
                        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
                        data-src="{{ image.thumb }}"
                        loading="lazy"
                        class="w-100 h-100 object-fit-cover lazy-image"
                        alt="Foto"
                >
            </a>
        </div>
    {% endfor %}
</div>
